generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model SalesOrder {
  id                        Int                     @id @default(autoincrement())
  orderCode                 String                  @unique @map("order_code") @db.VarChar(120)
  /** V112: LOẠI ĐƠN — MAU (Đơn hàng mẫu) | SAN_XUAT (Sản xuất) | LAM_LAI (Đơn làm lại). Chọn khi tạo đơn. */
  orderType                 String                  @default("MAU") @map("order_type") @db.VarChar(30)
  /** V112: TRẠNG THÁI — NHAP (Đơn nháp) | DA_XAC_NHAN (Đã xác nhận). Do nút Lưu quyết định. */
  status                    String                  @default("NHAP") @db.VarChar(30)
  customerCode              String?                 @map("customer_code") @db.VarChar(60)
  customerName              String?                 @map("customer_name") @db.VarChar(200)
  salesEmployeeCode         String?                 @map("sales_employee_code") @db.VarChar(60)
  orderDate                 DateTime?               @map("order_date") @db.Date
  requiredDeliveryDate      DateTime?               @map("required_delivery_date") @db.Date
  receiverName              String?                 @map("receiver_name") @db.VarChar(160)
  receiverPhone             String?                 @map("receiver_phone") @db.VarChar(40)
  receiverAddress           String?                 @map("receiver_address") @db.Text
  deliveryKm                Float?                  @map("delivery_km")
  region                    String?                 @db.VarChar(100)
  groupNo                   Int?                    @map("group_no")
  excelUpdateDate           DateTime?               @map("excel_update_date") @db.Date
  formCode                  String?                 @map("form_code") @db.VarChar(60)
  formEffectiveDate         DateTime?               @map("form_effective_date") @db.Date
  shippingFee               Decimal?                @map("shipping_fee") @db.Decimal(18, 2)
  shippingMountainDistrict  Boolean                 @default(false) @map("shipping_mountain_district")
  shippingCalculatedAt      DateTime?               @map("shipping_calculated_at")
  subtotal                  Decimal?                @db.Decimal(18, 2)
  discountPercent           Decimal?                @map("discount_percent") @db.Decimal(8, 4)
  discountAmount            Decimal?                @map("discount_amount") @db.Decimal(18, 2)
  totalAfterDiscount        Decimal?                @map("total_after_discount") @db.Decimal(18, 2)
  depositAmount             Decimal?                @map("deposit_amount") @db.Decimal(18, 2)
  warehouseReceiptDeduction Decimal?                @map("warehouse_receipt_deduction") @db.Decimal(18, 2)
  deliveryPayment           Decimal?                @map("delivery_payment") @db.Decimal(18, 2)
  sourceFileName            String?                 @map("source_file_name") @db.VarChar(255)
  sourceFileHash            String?                 @map("source_file_hash") @db.VarChar(64)
  lastImportedAt            DateTime?               @map("last_imported_at")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  items                     SalesOrderItem[]
  requirements              SalesOrderRequirement[]
  imports                   OrderImport[]
  shippingCalculations      ShippingCalculation[]

  @@index([customerCode])
  @@index([requiredDeliveryDate])
  @@index([status])
  @@index([orderType])
  @@index([lastImportedAt])
  // V130: index phục vụ lọc/báo cáo (order_date, created_at, NVKD, vùng miền).
  @@index([orderDate])
  @@index([createdAt])
  @@index([salesEmployeeCode])
  @@index([region])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               Int                    @id @default(autoincrement())
  orderId          Int                    @map("order_id")
  lineNo           Int                    @map("line_no")
  setNo            String?                @map("set_no") @db.VarChar(80)
  productName      String?                @map("product_name") @db.Text
  productCode      String?                @map("product_code") @db.VarChar(160)
  model            String?                @db.VarChar(100)
  openingDirection String?                @map("opening_direction") @db.VarChar(60)
  trimDirection    String?                @map("trim_direction") @db.VarChar(80)
  paintColor       String?                @map("paint_color") @db.VarChar(100)
  heightMm         Int?                   @map("height_mm")
  widthMm          Int?                   @map("width_mm")
  frameMm          Int?                   @map("frame_mm")
  clearHeightMm    Int?                   @map("clear_height_mm")
  clearWidthMm     Int?                   @map("clear_width_mm")
  panelInfo        String?                @map("panel_info") @db.VarChar(160)
  trimBarsPerSet   Int?                   @map("trim_bars_per_set")
  trimType         String?                @map("trim_type") @db.VarChar(80)
  lockModel        String?                @map("lock_model") @db.VarChar(120)
  windowBars       String?                @map("window_bars") @db.VarChar(160)
  leavesPerSet     Int?                   @map("leaves_per_set")
  quantity         Int?                   @db.Integer
  unit             String?                @db.VarChar(40)
  pricingQuantity  Float?                 @map("pricing_quantity")
  unitPrice        Decimal?               @map("unit_price") @db.Decimal(18, 2)
  amount           Decimal?               @db.Decimal(18, 2)
  note             String?                @db.Text
  imagePath        String?                @map("image_path") @db.Text
  /** V131: kích thước hiển thị ảnh SP do người dùng chỉnh tay (px). NULL = tự động vừa ô. */
  imageWidth       Int?                   @map("image_width")
  imageHeight      Int?                   @map("image_height")
  modelCheck       String?                @map("model_check") @db.VarChar(120)
  priceCheck       String?                @map("price_check") @db.VarChar(120)
  sourceRow        Int?                   @map("source_row")
  rawBlock         Json?                  @map("raw_block")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  order            SalesOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  details          SalesOrderItemDetail[]
  /** V133: nhiều ảnh cho một bộ cửa (ảnh số 1 cũng được ghi vào imagePath để tương thích). */
  images           SalesOrderItemImage[]

  @@unique([orderId, lineNo])
  @@index([setNo])
  @@index([productCode])
  // V130: index theo model phục vụ báo cáo sản phẩm.
  @@index([model])
  @@map("sales_order_items")
}

model SalesOrderItemImage {
  id          Int            @id @default(autoincrement())
  orderItemId Int            @map("order_item_id")
  sortOrder   Int            @default(1) @map("sort_order")
  imagePath   String         @map("image_path") @db.Text
  /** V131: kích thước hiển thị ảnh (px) do người dùng chỉnh tay. NULL = tự động vừa ô. */
  imageWidth  Int?           @map("image_width")
  imageHeight Int?           @map("image_height")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  orderItem   SalesOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, sortOrder])
  @@index([orderItemId, sortOrder])
  @@map("sales_order_item_images")
}

model SalesOrderItemDetail {
  id               Int            @id @default(autoincrement())
  orderItemId      Int            @map("order_item_id")
  rowOrder         Int            @map("row_order")
  detailType       String?        @map("detail_type") @db.VarChar(50)
  setNo            String?        @map("set_no") @db.VarChar(80)
  productName      String?        @map("product_name") @db.Text
  productCode      String?        @map("product_code") @db.VarChar(160)
  model            String?        @db.VarChar(100)
  openingDirection String?        @map("opening_direction") @db.VarChar(60)
  trimDirection    String?        @map("trim_direction") @db.VarChar(80)
  paintColor       String?        @map("paint_color") @db.VarChar(100)
  heightMm         Int?           @map("height_mm")
  widthMm          Int?           @map("width_mm")
  frameMm          Int?           @map("frame_mm")
  clearHeightMm    Int?           @map("clear_height_mm")
  clearWidthMm     Int?           @map("clear_width_mm")
  panelInfo        String?        @map("panel_info") @db.VarChar(160)
  trimBarsPerSet   Int?           @map("trim_bars_per_set")
  trimType         String?        @map("trim_type") @db.VarChar(80)
  lockModel        String?        @map("lock_model") @db.VarChar(120)
  windowBars       String?        @map("window_bars") @db.VarChar(160)
  leavesPerSet     Int?           @map("leaves_per_set")
  quantity         Int?           @db.Integer
  unit             String?        @db.VarChar(40)
  pricingQuantity  Float?         @map("pricing_quantity")
  unitPrice        Decimal?       @map("unit_price") @db.Decimal(18, 2)
  amount           Decimal?       @db.Decimal(18, 2)
  note             String?        @db.Text
  imagePath        String?        @map("image_path") @db.Text
  /** V131: kích thước hiển thị ảnh SP do người dùng chỉnh tay (px). NULL = tự động vừa ô. */
  imageWidth       Int?           @map("image_width")
  imageHeight      Int?           @map("image_height")
  modelCheck       String?        @map("model_check") @db.VarChar(120)
  priceCheck       String?        @map("price_check") @db.VarChar(120)
  sourceRow        Int?           @map("source_row")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  orderItem        SalesOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, rowOrder])
  @@index([productCode])
  @@map("sales_order_item_details")
}

model SalesOrderRequirement {
  id           Int        @id @default(autoincrement())
  orderId      Int        @map("order_id")
  code         String     @db.VarChar(60)
  questionText String     @map("question_text") @db.Text
  answer       String?    @db.VarChar(120)
  note         String?    @db.Text
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  order        SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, code])
  @@index([orderId, sortOrder])
  @@map("sales_order_requirements")
}

model OrderImport {
  id            Int         @id @default(autoincrement())
  orderId       Int?        @map("order_id")
  fileName      String      @map("file_name") @db.VarChar(255)
  fileHash      String      @map("file_hash") @db.VarChar(64)
  action        String      @db.VarChar(30)
  sheetName     String?     @map("sheet_name") @db.VarChar(120)
  importedItems Int         @default(0) @map("imported_items")
  importedAt    DateTime    @default(now()) @map("imported_at")
  order         SalesOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([fileHash])
  @@index([orderId, importedAt])
  @@map("order_imports")
}

/// V135: danh mục PHÂN LOẠI hàng hóa — thêm/đổi tên/xoá được từ tab Cấu hình (không còn hard-code).
/// - `usage` = MAIN  → nhóm này dùng làm DÒNG CHÍNH (bộ cửa) khi lập đơn
/// - `usage` = DETAIL → dùng làm DÒNG PHỤ KIỆN / CHI TIẾT
/// - `separateGroup` = true → khi lập đơn, các nhóm hàng thuộc phân loại này nằm trong optgroup riêng.
model ItemCategory {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(40)
  name          String   @db.VarChar(80)
  usage         String   @default("DETAIL") @db.VarChar(10)
  separateGroup Boolean  @default(false) @map("separate_group")
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([sortOrder])
  @@map("item_categories")
}

model ItemMaster {
  id                 Int      @id @default(autoincrement())
  code               String   @unique @db.VarChar(160)
  name               String   @db.Text
  // V134: phân loại hàng hóa ở tab Cấu hình — DOOR (cấp cửa) | ACCESSORY (phụ kiện) | PROCESSING (chi phí gia công).
  category           String   @default("ACCESSORY") @db.VarChar(20)
  productDescription String?  @map("product_description") @db.Text
  salesName          String?  @map("sales_name") @db.VarChar(120)
  salesModel         String?  @map("sales_model") @db.VarChar(180)
  unit               String?  @db.VarChar(40)
  dealerPrice        Decimal? @map("dealer_price") @db.Decimal(18, 2)
  retailPrice        Decimal? @map("retail_price") @db.Decimal(18, 2)
  active             Boolean  @default(true)
  source              String   @default("THU_CONG") @db.VarChar(30)
  lastSourceFile      String?  @map("last_source_file") @db.VarChar(255)
  lastImportedAt     DateTime? @map("last_imported_at")
  priceSourceFile    String?  @map("price_source_file") @db.VarChar(255)
  priceImportedAt    DateTime? @map("price_imported_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([active])
  @@index([category])
  @@index([salesName])
  @@index([salesModel])
  @@index([updatedAt])
  @@index([priceImportedAt])
  @@map("item_masters")
}

model ItemMasterImport {
  id             Int      @id @default(autoincrement())
  fileName       String   @map("file_name") @db.VarChar(255)
  fileHash       String   @map("file_hash") @db.VarChar(64)
  sheetName      String?  @map("sheet_name") @db.VarChar(120)
  totalRows      Int      @default(0) @map("total_rows")
  newCount       Int      @default(0) @map("new_count")
  changedCount   Int      @default(0) @map("changed_count")
  unchangedCount Int      @default(0) @map("unchanged_count")
  skippedCount   Int      @default(0) @map("skipped_count")
  errorCount     Int      @default(0) @map("error_count")
  issues         Json?
  importedAt     DateTime @default(now()) @map("imported_at")

  @@index([fileHash])
  @@index([importedAt])
  @@map("item_master_imports")
}

model ItemAttributeImport {
  id               Int      @id @default(autoincrement())
  fileName         String   @map("file_name") @db.VarChar(255)
  fileHash         String   @map("file_hash") @db.VarChar(64)
  sheetName        String?  @map("sheet_name") @db.VarChar(120)
  totalPriceRows   Int      @default(0) @map("total_price_rows")
  updatedItemCount Int      @default(0) @map("updated_item_count")
  missingItemCount Int      @default(0) @map("missing_item_count")
  optionCount      Int      @default(0) @map("option_count")
  issueCount       Int      @default(0) @map("issue_count")
  issues           Json?
  importedAt       DateTime @default(now()) @map("imported_at")

  @@index([fileHash])
  @@index([importedAt])
  @@map("item_attribute_imports")
}

model MasterOption {
  id             Int      @id @default(autoincrement())
  groupCode      String   @map("group_code") @db.VarChar(60)
  code           String   @db.VarChar(120)
  name           String   @db.VarChar(200)
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  source         String   @default("THU_CONG") @db.VarChar(30)
  lastSourceFile String?  @map("last_source_file") @db.VarChar(255)
  lastImportedAt DateTime? @map("last_imported_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([groupCode, code])
  @@index([groupCode, active, sortOrder])
  @@map("master_options")
}

model ShippingRate {
  id                Int      @id @default(autoincrement())
  doorGroup         String   @map("door_group") @db.VarChar(60)
  modelName         String   @map("model_name") @db.VarChar(160)
  modelCode         String   @map("model_code") @db.VarChar(60)
  quantityTier      Int      @map("quantity_tier")
  northLe100        Decimal  @map("north_le_100") @db.Decimal(18, 2)
  north101To200     Decimal  @map("north_101_200") @db.Decimal(18, 2)
  northOver200      Decimal  @map("north_over_200") @db.Decimal(18, 2)
  central           Decimal  @db.Decimal(18, 2)
  active            Boolean  @default(true)
  source             String   @default("EXCEL_2024") @db.VarChar(40)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([modelCode, quantityTier])
  @@index([active, modelCode, quantityTier])
  @@map("shipping_rates")
}

model ShippingModelMapping {
  id                Int      @id @default(autoincrement())
  sourceModel       String   @unique @map("source_model") @db.VarChar(160)
  shippingModelCode String   @map("shipping_model_code") @db.VarChar(60)
  note              String?  @db.Text
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([active, shippingModelCode])
  @@map("shipping_model_mappings")
}

model ShippingCalculation {
  id               Int        @id @default(autoincrement())
  orderId          Int        @map("order_id")
  region           String     @db.VarChar(100)
  deliveryKm       Decimal    @map("delivery_km") @db.Decimal(12, 2)
  mountainDistrict Boolean    @default(false) @map("mountain_district")
  bandLabel        String     @map("band_label") @db.VarChar(180)
  supportKm        Decimal    @map("support_km") @db.Decimal(12, 2)
  rawTotal         Decimal    @map("raw_total") @db.Decimal(18, 2)
  roundedTotal     Decimal    @map("rounded_total") @db.Decimal(18, 2)
  lines            Json
  source           String     @default("BANG_CUOC_EXCEL_2024") @db.VarChar(60)
  createdAt        DateTime   @default(now()) @map("created_at")
  order            SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("shipping_calculations")
}

/// V126: câu trả lời khảo sát nhà máy (bộ câu hỏi V125) — nhà máy điền trên app, lưu DB, xuất file khi xong.
model SurveyAnswer {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  answer    String?  @db.Text
  choice    String?  @db.VarChar(40)
  updatedBy String?  @map("updated_by") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("survey_answers")
}

// ============================================================================
// V136 — MODULE LÊN KẾ HOẠCH SẢN XUẤT
//
// Nguyên tắc: các bảng dưới đây CHỈ ĐỌC đơn hàng hiện có (SalesOrder /
// SalesOrderItem). Không sửa, không thêm cột vào bảng đơn hàng.
// Nguồn nghiệp vụ: kết quả khảo sát nhà máy 2026-09-26 (222/230 câu) + V136.
// Đơn vị lên kế hoạch = 1 BỘ CỬA (production_sets); theo dõi tới mức CÔNG ĐOẠN
// của từng bộ (production_tasks) theo yêu cầu KH22/L2/J5.
// ============================================================================

/// Tổ sản xuất / nguồn lực. Năng lực lấy từ khảo sát (V136 mục 1.3).
model ProductionWorkCenter {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(40)
  name           String   @db.VarChar(120)
  /// TO = tổ trong xưởng · NGUON_LUC_NGOAI = thuê ngoài · VAN_PHONG = văn phòng/kỹ thuật (vd Bồi Lares/CAM).
  /// (V140: Thiết kế đã tách sang tổ TO_THIET_KE với kind = 'TO'.)
  kind           String   @default("TO") @db.VarChar(20)
  peopleCount    Int?     @map("people_count")
  shiftsPerDay   Int?     @map("shifts_per_day")
  hoursPerShift  Float?   @map("hours_per_shift")
  /// Năng lực thật theo ngày, đơn vị ở capacityUnit. Để trống = không cảnh báo quá tải.
  capacityPerDay Float?   @map("capacity_per_day")
  /// CANH = lá cửa (đơn vị xưởng nói) · BO = bộ cửa · M2 = mét vuông.
  capacityUnit   String   @default("CANH") @map("capacity_unit") @db.VarChar(10)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("production_work_centers")
}

/// Danh mục CÔNG ĐOẠN (routing) — là DỮ LIỆU, không hard-code trong code.
model ProductionStage {
  id                  Int      @id @default(autoincrement())
  code                String   @unique @db.VarChar(40)
  name                String   @db.VarChar(160)
  /// CHUAN_BI = chuẩn bị (không nhân theo số bộ) · GIA_CONG · CHO = chờ · QC.
  kind                String   @default("GIA_CONG") @db.VarChar(20)
  /// BO = làm cho cả bộ · PARTS = tách khung/cánh/phào · MODEL = theo model (tái dùng).
  scopeMode           String   @default("BO") @map("scope_mode") @db.VarChar(20)
  /// Khi scopeMode = PARTS: danh sách bộ phận, vd "KHUNG,CANH,PHAO" hoặc "CANH" (Ép cánh).
  scopeParts          String?  @map("scope_parts") @db.VarChar(60)
  workCenterCode      String?  @map("work_center_code") @db.VarChar(40)
  seq                 Int      @default(0)
  /// Thời lượng chuẩn (giờ). 24 giờ = 1 ngày làm việc.
  leadTimeHours       Float?   @map("lead_time_hours")
  /// Setup/đổi (phút): chấn đổi khuôn 5', sơn đổi màu 120'.
  setupMinutes        Int?     @map("setup_minutes")
  capacityPerDay      Float?   @map("capacity_per_day")
  capacityUnit        String   @default("CANH") @map("capacity_unit") @db.VarChar(10)
  /// Gộp lô theo khóa: MAU_SON · MA_VAN · MODEL · (trống) = không gom.
  batchKey            String?  @map("batch_key") @db.VarChar(30)
  batchMinQty         Int?     @map("batch_min_qty")
  /// Số lượt đổi tối đa mỗi ngày (chấn: 2 lần/ngày).
  changeoverMaxPerDay Int?     @map("changeover_max_per_day")
  isQcPoint           Boolean  @default(false) @map("is_qc_point")
  /// Lỗi phát hiện ở đây thì quay lại công đoạn nào (test cơ khí → hàn).
  reworkToStage       String?  @map("rework_to_stage") @db.VarChar(40)
  /// Điều kiện bỏ qua dạng "PAINT_COLOR:11,14" (màu 11 & 14 không cần vân).
  skipCondition       String?  @map("skip_condition") @db.VarChar(160)
  /// Bắt buộc công đoạn này đã xong (Bồi Lares chặn Cắt).
  requiresStage       String?  @map("requires_stage") @db.VarChar(40)
  active              Boolean  @default(true)
  note                String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([active, seq])
  @@index([workCenterCode])
  @@map("production_stages")
}

/// Kế hoạch sản xuất theo tuần (KD + SX thống nhất, giám đốc nhà máy chốt).
model ProductionPlan {
  id         Int       @id @default(autoincrement())
  code       String    @unique @db.VarChar(60)
  fromDate   DateTime  @map("from_date") @db.Date
  toDate     DateTime  @map("to_date") @db.Date
  /// NHAP | DA_CHOT
  status     String    @default("NHAP") @db.VarChar(20)
  createdBy  String?   @map("created_by") @db.VarChar(120)
  approvedBy String?   @map("approved_by") @db.VarChar(120)
  approvedAt DateTime? @map("approved_at")
  note       String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  sets ProductionSet[]

  @@index([fromDate])
  @@map("production_plans")
}

/// 1 dòng = 1 BỘ CỬA — đơn vị lên kế hoạch.
model ProductionSet {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  /// Bộ cửa nguồn trong đơn (sales_order_items.id). Nullable để nhập bộ đang dở không khớp được.
  orderItemId       Int?      @unique @map("order_item_id")
  orderCode         String?   @map("order_code") @db.VarChar(120)
  setNo             String?   @map("set_no") @db.VarChar(80)
  orderType         String    @default("SAN_XUAT") @map("order_type") @db.VarChar(30)
  customerName      String?   @map("customer_name") @db.VarChar(200)
  productName       String?   @map("product_name") @db.Text
  model             String?   @db.VarChar(100)
  openingDirection  String?   @map("opening_direction") @db.VarChar(60)
  paintColor        String?   @map("paint_color") @db.VarChar(100)
  veneerCode        String?   @map("veneer_code") @db.VarChar(100)
  heightMm          Int?      @map("height_mm")
  widthMm           Int?      @map("width_mm")
  leavesPerSet      Int?      @map("leaves_per_set")
  trimBarsPerSet    Int?      @map("trim_bars_per_set")
  quantity          Int?      @db.Integer
  pricingQuantity   Float?    @map("pricing_quantity")
  /// Số cánh quy đổi để tính tải (xưởng nói bằng cánh). Chốt khi đưa vào kế hoạch.
  canhEquivalent    Int       @default(1) @map("canh_equivalent")
  dueDate           DateTime? @map("due_date") @db.Date
  planId            Int?      @map("plan_id")
  /// 0 = gấp nhất. Đơn làm lại chen trước (KH17).
  priority          Int       @default(5)
  /// CHO_XEP_LICH | DA_XEP_LICH | DANG_SX | HOAN_THANH | DA_GIAO | TAM_DUNG | HUY
  status            String    @default("CHO_XEP_LICH") @db.VarChar(30)
  percentDone       Int       @default(0) @map("percent_done")
  plannedStart      DateTime? @map("planned_start") @db.Date
  plannedEnd        DateTime? @map("planned_end") @db.Date
  /// V144 — ngày ĐƯA VÀO SẢN XUẤT (bấm nút ở bộ cửa) và ngày xong DỰ KIẾN của cả bộ.
  startedAt         DateTime? @map("started_at") @db.Date
  targetEnd         DateTime? @map("target_end") @db.Date
  actualCompletedAt DateTime? @map("actual_completed_at")
  actualDeliveredAt DateTime? @map("actual_delivered_at")
  programReady      Boolean   @default(false) @map("program_ready")
  materialReady     Boolean   @default(false) @map("material_ready")
  packCount         Int?      @map("pack_count")
  note              String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tasks          ProductionTask[]
  componentOrders ProductionComponentOrder[]
  workOrders     ProductionWorkOrder[]
  plan           ProductionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([planId])
  @@index([setNo])
  @@index([orderId])
  @@index([targetEnd])
  @@map("production_sets")
}

/// V136.1 — LỆNH SẢN XUẤT CON: mỗi BỘ CỬA (lệnh cha) tách thành ĐÚNG 3 lệnh con —
/// CÁNH, KHUNG, PHÀO — vì cắt/chấn/hàn/vân làm riêng cho từng phần.
///
/// Công đoạn của một lệnh con là các `production_tasks` có `scope` = kind tương ứng.
/// Trạng thái / % tiến độ / ngày kế hoạch của lệnh con được SUY RA từ công đoạn (không lưu trùng),
/// nên chỉ lưu ở đây số lượng và ghi chú.
model ProductionComponentOrder {
  id          Int      @id @default(autoincrement())
  setId       Int      @map("set_id")
  /// CANH | KHUNG | PHAO
  kind        String   @db.VarChar(10)
  /// Số lượng: cánh = số cánh × số bộ · khung = số bộ · phào = số phào × số bộ.
  qtyExpected Float?   @map("qty_expected")
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  set ProductionSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, kind])
  @@index([setId])
  @@map("production_component_orders")
}

/// 1 dòng = 1 BỘ × 1 CÔNG ĐOẠN (KH22: cập nhật ở mức công đoạn của từng bộ).
model ProductionTask {
  id              Int       @id @default(autoincrement())
  setId           Int       @map("set_id")
  orderItemId     Int?      @map("order_item_id")
  stageCode       String    @map("stage_code") @db.VarChar(40)
  stageKind       String    @default("GIA_CONG") @map("stage_kind") @db.VarChar(20)
  /// KHUNG | CANH | PHAO | BO
  scope           String    @default("BO") @db.VarChar(10)
  seq             Int       @default(0)
  workCenterCode  String?   @map("work_center_code") @db.VarChar(40)
  /// CHUA_LAM | DANG_LAM | XONG | BO_QUA | TAM_DUNG
  status          String    @default("CHUA_LAM") @db.VarChar(20)
  qtyExpected     Float?    @map("qty_expected")
  qtyDone         Float?    @map("qty_done")
  plannedStart    DateTime? @map("planned_start") @db.Date
  plannedEnd      DateTime? @map("planned_end") @db.Date
  /// V144 — MỐC (target) do hệ thống TỰ SUY từ ngày bắt đầu sản xuất + số giờ của bước.
  /// Khác `planned_*` (sau này là "ngày kế hoạch sản xuất" theo điều độ/lô gộp).
  targetStart     DateTime? @map("target_start") @db.Date
  targetEnd       DateTime? @map("target_end") @db.Date
  actualStart     DateTime? @map("actual_start")
  actualEnd       DateTime? @map("actual_end")
  assignee        String?   @db.VarChar(120)
  isRework        Boolean   @default(false) @map("is_rework")
  reworkFromStage String?   @map("rework_from_stage") @db.VarChar(40)
  reasonCode      String?   @map("reason_code") @db.VarChar(40)
  note            String?   @db.Text
  updatedBy       String?   @map("updated_by") @db.VarChar(120)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  set ProductionSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  workOrder ProductionWorkOrder?

  @@unique([setId, stageCode, scope])
  @@index([workCenterCode, plannedStart])
  @@index([status])
  @@index([plannedStart])
  @@index([targetEnd])
  @@map("production_tasks")
}

/// V142 — LỆNH SẢN XUẤT: mỗi bộ cửa phát ra 1 lệnh CHA (bộ) + 3 lệnh CON (cánh·khung·phào)
/// + 1 lệnh cho MỖI CÔNG ĐOẠN của bộ đó, mỗi lệnh có MÃ LỆNH riêng để phát cho tổ và tra cứu.
///
/// Theo đúng quy ước của lệnh con (xem ProductionComponentOrder): ở đây CHỈ lưu danh tính +
/// mã lệnh + ngày phát; SỐ LƯỢNG / TRẠNG THÁI / NGÀY KẾ HOẠCH đều SUY RA từ production_tasks
/// (lệnh công đoạn) hoặc từ bộ / lệnh con tương ứng — không lưu trùng để khỏi lệch số.
model ProductionWorkOrder {
  id        Int       @id @default(autoincrement())
  /// Mã lệnh, sinh theo mẫu trong Cấu hình sản xuất (`workOrderCodeTemplate`). Duy nhất toàn hệ thống.
  code      String    @unique @db.VarChar(220)
  setId     Int       @map("set_id")
  /// Lệnh công đoạn trỏ tới đúng dòng công đoạn; lệnh cha / lệnh con để trống.
  taskId    Int?      @unique @map("task_id")
  /// BO | CANH | KHUNG | PHAO | CONG_DOAN
  kind      String    @db.VarChar(20)
  /// Chép lại từ công đoạn để tra cứu khi lệnh công đoạn bị sinh lại.
  stageCode String?   @map("stage_code") @db.VarChar(40)
  scope     String?   @db.VarChar(10)
  seq       Int?
  /// Ngày phát lệnh cho tổ (in trên phiếu). Không có = chưa phát.
  issuedAt  DateTime? @map("issued_at") @db.Date
  issuedBy  String?   @map("issued_by") @db.VarChar(120)
  note      String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  set  ProductionSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  task ProductionTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([setId, kind])
  @@index([kind])
  @@index([stageCode])
  @@map("production_work_orders")
}
// ⚠️ Ngoài các ràng buộc trên, DB còn chỉ số RIÊNG PHẦN `production_work_orders_set_id_kind_key`
//    trên (set_id, kind) WHERE kind <> 'CONG_DOAN' — Prisma không khai được chỉ số có WHERE,
//    nên khi tạo migration bằng `prisma migrate dev` phải TỰ THÊM lại câu CREATE UNIQUE INDEX này.

/// Danh mục LÝ DO tạm dừng / trễ / máy dừng / lỗi.
model ProductionReason {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(160)
  /// TAM_DUNG | TRE_HAN | MAY_DUNG | LOI
  group     String   @default("TAM_DUNG") @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, group, sortOrder])
  @@map("production_reasons")
}

/// Lịch sử sửa kế hoạch (J1: cần lưu ai đổi gì, lúc nào).
model ProductionLog {
  id        Int      @id @default(autoincrement())
  /// PLAN | SET | TASK
  entity    String   @db.VarChar(20)
  entityId  Int      @map("entity_id")
  action    String   @db.VarChar(40)
  field     String?  @db.VarChar(60)
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  byName    String?  @map("by_name") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId, createdAt])
  @@map("production_logs")
}

/// Thư viện CHƯƠNG TRÌNH MÁY CẮT theo model (L5) — Bồi Lares tái dùng được.
model ProductionProgram {
  id              Int       @id @default(autoincrement())
  model           String    @db.VarChar(100)
  fileName        String?   @map("file_name") @db.VarChar(255)
  version         Int       @default(1)
  machine         String?   @db.VarChar(120)
  madeBy          String?   @map("made_by") @db.VarChar(120)
  madeAt          DateTime? @map("made_at")
  durationMinutes Int?      @map("duration_minutes")
  reusable        Boolean   @default(true)
  note            String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([model, version])
  @@index([model])
  @@map("production_programs")
}

/// Máy dừng + lý do (KH28).
model ProductionDowntime {
  id             Int       @id @default(autoincrement())
  workCenterCode String    @map("work_center_code") @db.VarChar(40)
  machine        String?   @db.VarChar(120)
  fromAt         DateTime  @map("from_at")
  toAt           DateTime? @map("to_at")
  reasonCode     String?   @map("reason_code") @db.VarChar(40)
  note           String?   @db.Text
  createdBy      String?   @map("created_by") @db.VarChar(120)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([workCenterCode, fromAt])
  @@map("production_machine_downtimes")
}

/// Ngày nghỉ / lễ (A2: không tính Chủ nhật và ngày lễ).
model ProductionCalendar {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique @db.Date
  isWorkingDay Boolean  @default(true) @map("is_working_day")
  note         String?  @db.VarChar(160)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("production_calendar")
}
